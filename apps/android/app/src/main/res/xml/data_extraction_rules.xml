<?xml version="1.0" encoding="utf-8"?>
<!-- Backup is off (allowBackup=false); these exclusions also cover device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="rulemix_session.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
        <exclude domain="file" path="cache/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="rulemix_session.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
        <exclude domain="file" path="cache/" />
    </device-transfer>
</data-extraction-rules>
