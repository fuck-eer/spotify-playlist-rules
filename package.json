{
  "name": "rulemix",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint && prettier --check .",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "format": "prettier -w .",
    "db:migrate": "tsx scripts/migrate.ts",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^20",
    "eslint": "^9",
    "prettier": "^3",
    "tsx": "^4",
    "turbo": "^2",
    "typescript": "^5.6",
    "typescript-eslint": "^8",
    "vitest": "^2"
  },
  "pnpm": {
    "overrides": {
      "tinypool": "2.1.2"
    }
  }
}
